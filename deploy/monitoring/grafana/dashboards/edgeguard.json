{
 "uid": "edgeguard",
 "title": "EdgeGuard MEC",
 "timezone": "browser",
 "refresh": "5s",
 "schemaVersion": 39,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Alerts / min",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(rate(edgeguard_alerts_total[1m]))*60",
     "legendFormat": "alerts"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Near misses (total / unalerted)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(edgeguard_near_miss_total)",
     "legendFormat": "total"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(edgeguard_near_miss_unalerted)",
     "legendFormat": "unalerted"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "HA leader",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
