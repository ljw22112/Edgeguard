
// EdgeGuard SDT domain (oneM2M TS-0023 style) - flexContainer specializations
// Domain:   org.edgeguard.safety    Namespace prefix: egs
//
// Device classes reuse the standard module class "battery" (cod:bat, org.onem2m.common) and add
// three module classes of their own.  Installed into a CSE by copying this file next to the
// CSE's own .fcp files (ACME: acmecse/init/), see docs/data-model.md.
[
    // ModuleClass: kinematicState (one update per position sample)
    {
        "type"      : "egs:kinSt",
        "lname"     : "kinematicState",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.kinematicState",
        "attributes": [
            // DataPoint: positionX, positionY (site frame, metres)
            { "sname" : "posX", "lname" : "positionX", "type" : "float", "car" : "1" },
            { "sname" : "posY", "lname" : "positionY", "type" : "float", "car" : "1" },
            // DataPoint: positionSigma (1-sigma position error, metres)
            { "sname" : "posSa", "lname" : "positionSigma", "type" : "float", "car" : "01" },
            // DataPoint: positionSource (uwb | mec | camera)
            { "sname" : "posSe", "lname" : "positionSource", "type" : "string", "car" : "01" },
            // DataPoint: speed (m/s, signed for forklifts: negative = reversing), heading (rad), yawRate (rad/s)
            { "sname" : "speed", "lname" : "speed", "type" : "float", "car" : "01" },
            { "sname" : "headg", "lname" : "heading", "type" : "float", "car" : "01" },
            { "sname" : "yawRe", "lname" : "yawRate", "type" : "float", "car" : "01" },
            // DataPoint: sampleTime (ms since the epoch, device clock)
            { "sname" : "smpTe", "lname" : "sampleTime", "type" : "integer", "car" : "1" }
        ]
    },

    // ModuleClass: workerCue (what the worker's tag shows)
    {
        "type"      : "egs:wrkCe",
        "lname"     : "workerCue",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.workerCue",
        "attributes": [
            // DataPoint: cueState (IDLE | WAIT | ASIDE | GO)
            { "sname" : "cueSe", "lname" : "cueState", "type" : "string", "car" : "1" },
            // DataPoint: cueSource (forklift the cue is about)
            { "sname" : "cueSo", "lname" : "cueSource", "type" : "string", "car" : "01" }
        ]
    },

    // ModuleClass: speedLimit (what the forklift module enforces)
    {
        "type"      : "egs:spdLt",
        "lname"     : "speedLimit",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.speedLimit",
        "attributes": [
            // DataPoint: limit (m/s, absent = no limit), maxSpeed (m/s)
            { "sname" : "limit", "lname" : "limit", "type" : "float", "car" : "01" },
            { "sname" : "maxSd", "lname" : "maxSpeed", "type" : "float", "car" : "01" }
        ]
    },

    // DeviceClass: workerTag
    {
        "type"      : "egs:wrkTg",
        "lname"     : "workerTag",
        "sdttype"   : "device",
        "cnd"       : "org.edgeguard.safety.device.workerTag",
        "attributes": [
            // Property: zone (site zone the tag is in)
            { "sname" : "zone", "lname" : "zone", "type" : "string", "car" : "01" }
        ],
        "children"  : [ "egs:kinSt", "egs:wrkCe", "cod:bat" ]
    },

    // DeviceClass: forkliftModule
    {
        "type"      : "egs:frkMe",
        "lname"     : "forkliftModule",
        "sdttype"   : "device",
        "cnd"       : "org.edgeguard.safety.device.forkliftModule",
        "attributes": [
            { "sname" : "zone", "lname" : "zone", "type" : "string", "car" : "01" }
        ],
        "children"  : [ "egs:kinSt", "egs:spdLt", "cod:bat" ]
    },

    // ModuleClass: federatedLearningTask (coordinator: what is trained, how, and where it stands; TR-0084)
    {
        "type"      : "egs:flTsk",
        "lname"     : "federatedLearningTask",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.federatedLearningTask",
        "attributes": [
            { "sname" : "mdlNm", "lname" : "modelName", "type" : "string", "car" : "1" },
            { "sname" : "rnds",  "lname" : "rounds", "type" : "integer", "car" : "1" },
            { "sname" : "curRd", "lname" : "currentRound", "type" : "integer", "car" : "01" },
            { "sname" : "cpr",   "lname" : "clientsPerRound", "type" : "integer", "car" : "1" },
            { "sname" : "quorm", "lname" : "quorum", "type" : "integer", "car" : "01" },
            { "sname" : "minSm", "lname" : "minSamples", "type" : "integer", "car" : "01" },
            { "sname" : "lclEp", "lname" : "localEpochs", "type" : "integer", "car" : "01" },
            { "sname" : "lrnRt", "lname" : "learningRate", "type" : "float", "car" : "01" },
            { "sname" : "rdTmo", "lname" : "roundTimeout", "type" : "float", "car" : "01" },
            { "sname" : "tskSt", "lname" : "taskStatus", "type" : "string", "car" : "01" },
            { "sname" : "mdlVr", "lname" : "modelVersion", "type" : "integer", "car" : "01" }
        ]
    },

    // ModuleClass: federatedLearningParticipant (a client: its data, availability, progress; TR-0084)
    {
        "type"      : "egs:flPrt",
        "lname"     : "federatedLearningParticipant",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.federatedLearningParticipant",
        "attributes": [
            { "sname" : "site",  "lname" : "site", "type" : "string", "car" : "01" },
            { "sname" : "smpCt", "lname" : "sampleCount", "type" : "integer", "car" : "1" },
            { "sname" : "avail", "lname" : "available", "type" : "boolean", "car" : "1" },
            { "sname" : "cmpSc", "lname" : "computeScore", "type" : "float", "car" : "01" },
            { "sname" : "lstRd", "lname" : "lastRound", "type" : "integer", "car" : "01" },
            { "sname" : "mdlVr", "lname" : "modelVersion", "type" : "integer", "car" : "01" },
            { "sname" : "prtSt", "lname" : "participantStatus", "type" : "string", "car" : "01" }
        ]
    },
    // ---- ETSI MEC data as oneM2M resources, written by the MEC-IPE (docs/mobility.md) ----

    // ModuleClass: mecUserLocation (MEC 013 UserInfo of one UE)
    {
        "type"      : "egs:ueLoc",
        "lname"     : "mecUserLocation",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.mecUserLocation",
        "attributes": [
            { "sname" : "lat",   "lname" : "latitude", "type" : "float", "car" : "1" },
            { "sname" : "lon",   "lname" : "longitude", "type" : "float", "car" : "1" },
            { "sname" : "accy",  "lname" : "accuracy", "type" : "float", "car" : "01" },
            { "sname" : "zonId", "lname" : "zoneId", "type" : "string", "car" : "01" },
            { "sname" : "apId",  "lname" : "accessPointId", "type" : "string", "car" : "01" },
            { "sname" : "locTs", "lname" : "locationTime", "type" : "integer", "car" : "01" }
        ]
    },

    // ModuleClass: mecRadioLink (MEC 012 MeasRepUe: serving and strongest neighbour cell)
    {
        "type"      : "egs:rdLnk",
        "lname"     : "mecRadioLink",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.mecRadioLink",
        "attributes": [
            { "sname" : "srvCl", "lname" : "servingCell", "type" : "string", "car" : "1" },
            { "sname" : "rsrp",  "lname" : "rsrp", "type" : "integer", "car" : "01" },
            { "sname" : "rsrq",  "lname" : "rsrq", "type" : "integer", "car" : "01" },
            { "sname" : "nbCl",  "lname" : "neighbourCell", "type" : "string", "car" : "01" },
            { "sname" : "nbRp",  "lname" : "neighbourRsrp", "type" : "integer", "car" : "01" },
            { "sname" : "msTs",  "lname" : "measurementTime", "type" : "integer", "car" : "01" }
        ]
    },

    // DeviceClass: mecUserEquipment (a UE as the MEC platform sees it)
    {
        "type"      : "egs:mecUe",
        "lname"     : "mecUserEquipment",
        "sdttype"   : "device",
        "cnd"       : "org.edgeguard.safety.device.mecUserEquipment",
        "attributes": [
            { "sname" : "addr",  "lname" : "address", "type" : "string", "car" : "1" }
        ],
        "children"  : [ "egs:ueLoc", "egs:rdLnk" ]
    },

    // ---- MEC application orchestration across hosts (docs/orchestration.md) ----

    // ModuleClass: mecHost (a MEC host offering capacity for EdgeGuard applications)
    {
        "type"      : "egs:mecHs",
        "lname"     : "mecHost",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.mecHost",
        "attributes": [
            { "sname" : "hstNm", "lname" : "hostName", "type" : "string", "car" : "1" },
            { "sname" : "zone",  "lname" : "zone", "type" : "string", "car" : "01" },
            { "sname" : "cpuFr", "lname" : "cpuFree", "type" : "float", "car" : "01" },
            { "sname" : "memFr", "lname" : "memoryFreeMB", "type" : "integer", "car" : "01" },
            { "sname" : "rttMs", "lname" : "rttToSiteMs", "type" : "float", "car" : "01" },
            { "sname" : "lcmUr", "lname" : "lifecycleApiUrl", "type" : "string", "car" : "1" },
            { "sname" : "hstSt", "lname" : "hostStatus", "type" : "string", "car" : "01" }
        ]
    },

    // ModuleClass: deploymentIntent (what should run where, and its current placement)
    {
        "type"      : "egs:depIn",
        "lname"     : "deploymentIntent",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.deploymentIntent",
        "attributes": [
            { "sname" : "appNm", "lname" : "appName", "type" : "string", "car" : "1" },
            { "sname" : "appVr", "lname" : "appVersion", "type" : "string", "car" : "01" },
            { "sname" : "zone",  "lname" : "zone", "type" : "string", "car" : "01" },
            { "sname" : "cpuMn", "lname" : "cpuRequired", "type" : "float", "car" : "01" },
            { "sname" : "memMn", "lname" : "memoryRequiredMB", "type" : "integer", "car" : "01" },
            { "sname" : "maxLt", "lname" : "maxLatencyMs", "type" : "float", "car" : "01" },
            { "sname" : "intSt", "lname" : "intentStatus", "type" : "string", "car" : "01" },
            { "sname" : "plcmt", "lname" : "placement", "type" : "string", "car" : "01" },
            { "sname" : "appAe", "lname" : "appEntity", "type" : "string", "car" : "01" }
        ]
    },

    // ModuleClass: modelDeployment (a federated model delivered to a MEC app: canary, active, rolled back)
    {
        "type"      : "egs:mdlDp",
        "lname"     : "modelDeployment",
        "sdttype"   : "moduleclass",
        "cnd"       : "org.edgeguard.safety.moduleclass.modelDeployment",
        "attributes": [
            { "sname" : "mdlVr", "lname" : "modelVersion", "type" : "integer", "car" : "01" },
            { "sname" : "prvVr", "lname" : "previousVersion", "type" : "integer", "car" : "01" },
            { "sname" : "dplSt", "lname" : "deploymentStatus", "type" : "string", "car" : "01" },
            { "sname" : "cnyEr", "lname" : "canaryError", "type" : "float", "car" : "01" },
            { "sname" : "bslEr", "lname" : "baselineError", "type" : "float", "car" : "01" },
            { "sname" : "lvErr", "lname" : "liveError", "type" : "float", "car" : "01" }
        ]
    }
]
